<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KuroReader</RootNamespace>
    <AssemblyName>KuroReader</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Performance: enable tiered compilation and ReadyToRun for fast startup -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp for high-perf image rendering (CPU + optional GPU) -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />

    <!-- SharpCompress for RAR, 7Z, ZIP archive support -->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

</Project>
